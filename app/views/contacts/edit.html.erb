<% content_for :title, "Edit #{@contact.full_name}" %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="d-flex align-items-center mb-4">
      <%= link_to contact_path(@contact), class: "btn btn-outline-secondary me-3" do %>
        <i class="bi bi-arrow-left me-1"></i>Back
      <% end %>
      <h1 class="h3 fw-bold mb-0">
        <i class="bi bi-pencil-fill text-warning me-2"></i>Edit <%= @contact.full_name %>
      </h1>
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-4">
        <%= form_with model: @contact, local: true do |f| %>
          <%= render "form", contact: @contact, f: f, tags: @tags %>
          <div class="d-flex gap-2 mt-4">
            <%= f.submit "Update Contact", class: "btn btn-warning btn-lg" %>
            <%= link_to "Cancel", contact_path(@contact), class: "btn btn-outline-secondary btn-lg" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
