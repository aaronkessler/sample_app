<% content_for :title, "New Contact" %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="d-flex align-items-center mb-4">
      <%= link_to contacts_path, class: "btn btn-outline-secondary me-3" do %>
        <i class="bi bi-arrow-left me-1"></i>Back
      <% end %>
      <h1 class="h3 fw-bold mb-0"><i class="bi bi-person-plus-fill text-primary me-2"></i>New Contact</h1>
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-4">
        <%= form_with model: @contact, local: true do |f| %>
          <%= render "form", contact: @contact, f: f, tags: @tags %>
          <div class="d-flex gap-2 mt-4">
            <%= f.submit "Save Contact", class: "btn btn-primary btn-lg" %>
            <%= link_to "Cancel", contacts_path, class: "btn btn-outline-secondary btn-lg" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
