<% content_for :title, "Tags" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 fw-bold mb-0"><i class="bi bi-tags-fill text-primary me-2"></i>Tags</h1>
  <%= link_to new_tag_path, class: "btn btn-primary" do %>
    <i class="bi bi-plus-lg me-1"></i>New Tag
  <% end %>
</div>

<% if @tags.empty? %>
  <div class="text-center py-5 text-muted">
    <i class="bi bi-tags" style="font-size: 4rem;"></i>
    <p class="mt-3 fs-5">No tags yet.</p>
    <p>Tags let you group contacts into lists, like "Holiday Card" or "Book Club".</p>
    <%= link_to new_tag_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>Create your first tag
    <% end %>
  </div>
<% else %>
  <div class="card shadow-sm">
    <div class="list-group list-group-flush">
      <% @tags.each do |tag| %>
        <div class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <i class="bi bi-tag-fill text-primary me-2"></i>
            <strong><%= tag.name %></strong>
            <span class="text-muted ms-2 small"><%= pluralize(tag.contacts.count, "contact") %></span>
          </div>
          <div class="d-flex gap-2">
            <%= link_to contacts_path(tag_id: tag.id), class: "btn btn-sm btn-outline-primary" do %>
              <i class="bi bi-people me-1"></i>View Contacts
            <% end %>
            <%= link_to edit_tag_path(tag), class: "btn btn-sm btn-outline-warning" do %>
              <i class="bi bi-pencil"></i>
            <% end %>
            <%= button_to tag_path(tag), method: :delete, class: "btn btn-sm btn-outline-danger",
                data: { turbo_confirm: "Delete tag '#{tag.name}'? Contacts will not be deleted." } do %>
              <i class="bi bi-trash"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<div class="mt-4">
  <%= link_to contacts_path, class: "btn btn-outline-secondary" do %>
    <i class="bi bi-arrow-left me-1"></i>Back to Contacts
  <% end %>
</div>
