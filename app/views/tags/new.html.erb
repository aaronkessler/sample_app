<% content_for :title, "New Tag" %>

<div class="row justify-content-center">
  <div class="col-12 col-md-6 col-lg-4">
    <div class="d-flex align-items-center mb-4">
      <%= link_to tags_path, class: "btn btn-outline-secondary me-3" do %>
        <i class="bi bi-arrow-left me-1"></i>Back
      <% end %>
      <h1 class="h3 fw-bold mb-0"><i class="bi bi-tag-fill text-primary me-2"></i>New Tag</h1>
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-4">
        <%= form_with model: @tag, url: tags_path, local: true do |f| %>
          <% if @tag.errors.any? %>
            <div class="alert alert-danger">
              <% @tag.errors.full_messages.each do |msg| %>
                <div><%= msg %></div>
              <% end %>
            </div>
          <% end %>
          <div class="mb-4">
            <%= f.label :name, "Tag Name", class: "form-label fw-semibold" %>
            <%= f.text_field :name, class: "form-control form-control-lg",
                placeholder: "e.g. Holiday Card, Book Club…", autofocus: true %>
            <div class="form-text">Tags help you filter and group contacts for specific lists.</div>
          </div>
          <div class="d-flex gap-2">
            <%= f.submit "Create Tag", class: "btn btn-primary" %>
            <%= link_to "Cancel", tags_path, class: "btn btn-outline-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
